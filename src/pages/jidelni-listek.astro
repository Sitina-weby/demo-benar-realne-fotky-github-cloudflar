---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import FullMenu from "../components/FullMenu.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site.config";
---

<BaseLayout
  title={`Jídelní lístek — ${siteConfig.business.name}`}
  description={`Celý stálý jídelní lístek restaurace ${siteConfig.business.fullName}.`}
>
  <Header />
  <main id="hlavni-obsah">
    <section class="section">
      <div class="container">
        <p class="eyebrow">Jídelní lístek</p>
        <h1>Celý stálý jídelní lístek</h1>
        <p>
          <a href="/" class="btn btn-outline">← Zpět na úvodní stránku</a>
        </p>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <FullMenu />
      </div>
    </section>
  </main>

  <Footer />
  <StickyMobileCTA />
</BaseLayout>

<style>
  @media (max-width: 767px) {
    main {
      padding-bottom: 72px;
    }
  }
</style>
