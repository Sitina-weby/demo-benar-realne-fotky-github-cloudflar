---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteConfig as s } from "../data/site.config";
---

<BaseLayout
  title={`Jídelní lístek — ${s.name}`}
  description={`Jídelní lístek restaurace ${s.fullName}.`}
>
  <SiteHeader />
  <main id="hlavni-obsah">
    <section class="section">
      <div class="wrap menu-cta">
        <span class="eyebrow">Jídelní lístek</span>
        <h1>Jídelní lístek</h1>
        <div class="notice">
          <strong>Oficiální jídelní lístek zatím nemáme ověřený.</strong>
          Jídla ani ceny proto na tomto webu neuvádíme. Aktuální nabídku vám sdělí restaurace
          telefonicky nebo ji najdete na Facebooku.
        </div>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--wine" href={`tel:${s.phone}`}>Zavolat {s.phoneDisplay}</a>
          <a class="btn btn--gold" href={s.facebookUrl} rel="noopener">Facebook restaurace</a>
          <a class="btn btn--wine" href="/">← Zpět na úvod</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
