---
import { siteConfig } from "../data/site.config";

const { contact, business } = siteConfig;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapEmbedQuery)}&output=embed`;
---

<section class="section section--alt" id="kontakt">
  <div class="container contact__grid">
    <div class="contact__info card">
      <h2>Kontakt</h2>
      <p><strong>{business.fullName}</strong></p>
      <p>{contact.address}</p>
      <p>
        <a href={`tel:${business.phone}`} class="contact__link">📞 {business.phoneDisplay}</a>
      </p>
      <p>
        <a href={contact.facebookUrl} target="_blank" rel="noopener noreferrer" class="contact__link">
          Facebook stránka
        </a>
      </p>

      <h3 class="contact__amenities-title">Vybavení a služby</h3>
      <ul class="contact__amenities">
        {contact.amenities.map((a) => <li class="badge">{a}</li>)}
      </ul>
    </div>

    <div class="contact__map">
      <iframe
        src={mapSrc}
        width="100%"
        height="100%"
        style="border:0; min-height: 320px;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa — poloha restaurace Benar"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-6);
  }
  .contact__info h2 {
    margin-top: 0;
  }
  .contact__link {
    color: var(--color-brass, #a9793b);
    font-weight: 600;
    text-decoration: none;
  }
  .contact__link:hover {
    text-decoration: underline;
  }
  .contact__amenities-title {
    margin-top: var(--space-5);
    font-size: var(--fs-base);
  }
  .contact__amenities {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .contact__map iframe {
    display: block;
    border-radius: var(--radius-md, 8px);
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
    .contact__map iframe {
      height: 100%;
    }
  }
</style>
