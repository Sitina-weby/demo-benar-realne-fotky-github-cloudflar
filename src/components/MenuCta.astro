---
import { siteConfig } from "../data/site.config";
const { menu, business } = siteConfig;
---

<section class="section section--dark menu-cta" id="jidelni-listek">
  <div class="container menu-cta__inner">
    <p class="eyebrow">Co si dát</p>
    <h2>{menu.heading}</h2>
    {
      menu.url ? (
        <a href={menu.url} class="btn btn-primary">Otevřít jídelní lístek</a>
      ) : (
        <>
          <p class="menu-cta__pending">{menu.pending}</p>
          <p>
            <a href={menu.pagePath} class="btn btn-primary">Stránka jídelního lístku</a>
            <a href={"tel:" + business.phone} class="btn btn-outline">Zavolat {business.phoneDisplay}</a>
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  .menu-cta__inner {
    text-align: center;
    max-width: 720px;
  }
  .menu-cta__pending {
    font-size: var(--fs-lg);
  }
  .menu-cta .btn {
    margin: var(--space-1);
  }
</style>
