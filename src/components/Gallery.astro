---
import { siteConfig } from "../data/site.config";
const { gallery } = siteConfig;
---

<section class="section section--alt" id="galerie">
  <div class="container">
    <p class="eyebrow">Atmosféra</p>
    <h2>{gallery.heading}</h2>
    <p class="gallery__note">{gallery.note}{gallery.aiNote ? " " + gallery.aiNote : ""}</p>
    <div class="gallery__grid">
      {
        gallery.images.map((img, i) => (
          <figure class:list={["gallery__item", i % 5 === 0 && "gallery__item--wide"]}>
            <picture>
              <source type="image/webp" srcset={img.webp} />
              <img src={img.jpg} alt={img.alt} loading="lazy" />
            </picture>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery__note {
    font-size: var(--fs-sm);
    color: var(--color-ink-soft);
    margin-bottom: var(--space-8);
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: var(--space-3);
  }
  .gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
  }
  .gallery__item picture {
    display: block;
    height: 100%;
  }
  .gallery__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .gallery__item:hover img {
    transform: scale(1.05);
  }
  .gallery__item--wide {
    grid-column: span 2;
  }
  .gallery__item--wide img {
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 860px) {
    .gallery__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
