---
import { siteConfig } from "../data/site.config";

const { events } = siteConfig;
---

<section class="section" id="akce">
  <div class="container">
    <p class="eyebrow">Akce</p>
    <h2>Co se u nás chystá</h2>

    <div class="events__grid">
      {
        events.map((e) => (
          <article class="events__card card">
            <h3>{e.title}</h3>
            <p class="events__date">{e.date}</p>
            <p>{e.description}</p>
            <p class="events__note">({e.note})</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .events__grid {
    display: grid;
    gap: var(--space-4);
  }
  .events__date {
    font-weight: 600;
    color: var(--color-brass, #a9793b);
    margin: 0 0 var(--space-2);
  }
  .events__note {
    font-size: var(--fs-xs);
    color: var(--color-text-muted, #666);
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .events__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
