---
import { siteConfig } from "../data/site.config";
const { business, contact, demoNotice, menu } = siteConfig;
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">{business.fullName}</p>
      <p>{contact.address}</p>
      <p><a href={"tel:" + business.phone}>{business.phoneDisplay}</a></p>
    </div>
    <nav class="footer__nav" aria-label="Odkazy v patičce">
      <a href="/#o-nas">O nás</a>
      <a href={menu.url ?? menu.pagePath}>Jídelní lístek</a>
      <a href="/#galerie">Galerie</a>
      <a href="/#kontakt">Kontakt</a>
      <a href={business.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
    </nav>
  </div>
  <div class="container">
    <p class="footer__notice">{demoNotice}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-forest);
    color: #f2e6d2;
    padding-block: var(--space-12) var(--space-20);
  }
  .footer a {
    color: #f2e6d2;
  }
  .footer__grid {
    display: grid;
    gap: var(--space-6);
  }
  .footer__name {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
  }
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer__notice {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--space-4);
    margin-top: var(--space-6);
    font-size: var(--fs-xs);
    color: #d8c9a3;
  }
  @media (min-width: 768px) {
    .footer {
      padding-block: var(--space-12);
    }
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
