---
import { siteConfig } from "../data/site.config";

const { business, contact, demoNotice } = siteConfig;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">{business.fullName}</p>
      <p>{contact.address}</p>
      <p><a href={`tel:${business.phone}`}>{business.phoneDisplay}</a></p>
      <p>
        <a href={contact.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
      </p>
    </div>
    <nav class="footer__nav" aria-label="Odkazy v patičce">
      <a href="#denni-menu">Denní menu</a>
      <a href="/jidelni-listek">Jídelní lístek</a>
      <a href="#galerie">Galerie</a>
      <a href="#rezervace">Rezervace</a>
      <a href="#kontakt">Kontakt</a>
    </nav>
  </div>

  <div class="container">
    <p class="footer__demo-notice">⚠️ {demoNotice.text}</p>
    <p class="footer__copy">&copy; {year} {business.name} — demo web</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink, #26332a);
    color: #f2e6d2;
    padding-block: var(--space-10) var(--space-20);
  }
  .footer a {
    color: #f2e6d2;
  }
  .footer__grid {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .footer__name {
    font-weight: 700;
    font-size: var(--fs-lg);
  }
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer__demo-notice {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--space-4);
    font-size: var(--fs-xs);
    color: #d8c9a3;
  }
  .footer__copy {
    font-size: var(--fs-xs);
    color: #b8ab8c;
  }

  @media (min-width: 768px) {
    .footer {
      padding-block: var(--space-10);
    }
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
