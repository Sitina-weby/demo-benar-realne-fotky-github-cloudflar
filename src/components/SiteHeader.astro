---
import { siteConfig } from "../data/site.config";
const { business, menuLink } = siteConfig;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">{business.name}</a>
    <nav class="site-header__nav" aria-label="Hlavní navigace">
      <a href="/#o-nas">O nás</a>
      <a href="/#galerie">Galerie</a>
      <a href="/#kontakt-a-hodiny">Kontakt</a>
      <a href={menuLink.href} class="btn btn-primary site-header__menu">{menuLink.label}</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(250, 243, 232, 0.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-bg-alt); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-3); }
  .site-header__brand { font-family: var(--font-heading); font-size: var(--fs-xl); color: var(--color-forest); text-decoration: none; font-weight: 700; }
  .site-header__nav { display: flex; align-items: center; gap: var(--space-6); }
  .site-header__nav a:not(.btn) { color: var(--color-ink); text-decoration: none; font-weight: 600; font-size: var(--fs-sm); }
  .site-header__nav a:not(.btn):hover { color: var(--color-brass-dark); }
  .site-header__menu { padding-block: var(--space-2); }
  @media (max-width: 639px) { .site-header__nav a:not(.btn) { display: none; } }
</style>
