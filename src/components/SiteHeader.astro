---
import { siteConfig } from "../data/site.config";
const { business } = siteConfig;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">{business.name}</a>
    <nav aria-label="Hlavní navigace" class="site-header__nav">
      <a href="/#denni-menu">Denní menu</a>
      <a href="/#galerie">Galerie</a>
      <a href="/#kontakt-a-hodiny">Kontakt</a>
      <a href="/jidelni-listek" class="btn btn-primary site-header__menu">Jídelní lístek</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 250, 242, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-bg-alt);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .site-header__brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-xl);
    color: var(--color-forest);
    text-decoration: none;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .site-header__nav a:not(.btn) {
    display: none;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .site-header__menu {
    padding: 0.5rem 1.1rem;
  }
  @media (min-width: 768px) {
    .site-header__nav a:not(.btn) {
      display: inline;
    }
  }
</style>
