---
import { siteConfig } from "../data/site.config";

const { dailyMenu } = siteConfig;
---

<section class="section section--alt" id="denni-menu">
  <div class="container">
    <p class="eyebrow">Denní nabídka</p>
    <h2>Denní menu</h2>
    <p class="daily-menu__meta">
      Podáváme {dailyMenu.servedTime} &middot; {dailyMenu.date}
    </p>
    <p class="daily-menu__note">{dailyMenu.note}</p>

    <div class="daily-menu__soup card">
      <span class="daily-menu__label">Polévka</span>
      <span class="daily-menu__name">{dailyMenu.soup.name}</span>
      <span class="daily-menu__allergens">Alergeny: {dailyMenu.soup.allergens.join(", ")}</span>
      <span class="daily-menu__price">{dailyMenu.soup.price} Kč</span>
    </div>

    <ul class="daily-menu__list">
      {
        dailyMenu.mainDishes.map((dish) => (
          <li class="daily-menu__item card">
            <span class="daily-menu__number">{dish.number}</span>
            <div class="daily-menu__item-body">
              <span class="daily-menu__name">{dish.name}</span>
              <span class="daily-menu__weight">{dish.weight} &middot; alergeny: {dish.allergens.join(", ")}</span>
            </div>
            <span class="daily-menu__price">{dish.price} Kč</span>
          </li>
        ))
      }
    </ul>

    <p class="daily-menu__order">{dailyMenu.orderNote}</p>
  </div>
</section>

<style>
  .daily-menu__meta {
    font-size: var(--fs-lg);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .daily-menu__note {
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-6);
  }

  .daily-menu__soup {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--fs-sm);
  }
  .daily-menu__label {
    font-weight: 700;
    color: var(--color-brass-dark);
    text-transform: uppercase;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
  }
  .daily-menu__allergens {
    font-size: var(--fs-xs);
    color: var(--color-ink-soft);
  }

  .daily-menu__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .daily-menu__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
  }
  .daily-menu__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-forest);
    color: #fff;
    font-weight: 700;
    flex-shrink: 0;
  }
  .daily-menu__item-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .daily-menu__name {
    font-weight: 600;
  }
  .daily-menu__weight {
    font-size: var(--fs-xs);
    color: var(--color-ink-soft);
  }
  .daily-menu__price {
    font-weight: 700;
    color: var(--color-brass-dark);
    white-space: nowrap;
  }

  .daily-menu__order {
    font-size: var(--fs-sm);
    font-weight: 600;
    margin-bottom: 0;
  }

  @media (max-width: 480px) {
    .daily-menu__soup {
      grid-template-columns: auto 1fr;
      row-gap: var(--space-1);
    }
  }
</style>
