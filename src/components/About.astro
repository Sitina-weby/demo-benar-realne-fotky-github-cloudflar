---
import { siteConfig } from "../data/site.config";
const { about, amenities } = siteConfig;
---

<section class="section" id="o-nas">
  <div class="container about__grid">
    <picture class="about__photo">
      <source type="image/webp" srcset={about.image.webp} />
      <img src={about.image.jpg} alt={about.image.alt} loading="lazy" />
    </picture>
    <div>
      <p class="eyebrow">O nás · od roku {about.foundedYear}</p>
      <h2>{about.heading}</h2>
      {about.paragraphs.map((p) => <p>{p}</p>)}
      <ul class="about__tags">
        {amenities.map((a) => <li class="badge">{a}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .about__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lifted);
    display: block;
  }
  .about__tags {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-16);
    }
  }
</style>
