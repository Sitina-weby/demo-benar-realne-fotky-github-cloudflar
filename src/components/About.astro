---
import { siteConfig } from "../data/site.config";

const { about, business, contact } = siteConfig;
---

<section class="section" id="o-nas">
  <div class="container about">
    <div class="about__text">
      <p class="eyebrow">O nás</p>
      <h2>{business.fullName} — od roku {about.foundedYear}</h2>
      <p class="about__teaser">{about.teaser}</p>
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <aside class="about__amenities card">
      <h3>Co u nás najdete</h3>
      <ul>
        {contact.amenities.map((a) => <li>{a}</li>)}
      </ul>
      <p class="about__theatre">🎭 {about.theatreConnection}</p>
    </aside>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-8);
  }
  .about__teaser {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .about__amenities ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about__amenities li {
    padding-left: 1.4em;
    position: relative;
    font-size: var(--fs-sm);
  }
  .about__amenities li::before {
    content: "•";
    color: var(--color-brass);
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  .about__theatre {
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--color-ink-soft);
    margin-bottom: 0;
  }

  @media (min-width: 992px) {
    .about {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }
</style>
