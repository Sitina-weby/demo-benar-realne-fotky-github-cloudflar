---
// HoursBadge — zobrazuje aktuální stav otevírací doby ("Otevřeno do HH:MM" /
// "Zavřeno, otevíráme v HH:MM"). Počáteční stav se vypočítá i na serveru
// (SSR/build-time) pomocí getHoursStatus, aby badge nebyl prázdný před
// hydratací; klientský inline script ho pak každou minutu přepočítá podle
// reálného aktuálního času v prohlížeči (Europe/Prague), takže badge je
// vždy aktuální i když návštěvník nechá stránku otevřenou přes půlnoc.
import { siteConfig } from "../data/site.config";
import { getHoursStatus } from "../utils/hours";

const initialStatus = getHoursStatus(siteConfig.hours.schedule, new Date());

interface Props {
  variant?: "default" | "compact";
}
const { variant = "default" } = Astro.props;
---

<span
  class:list={["hours-badge badge", variant === "compact" && "hours-badge--compact"]}
  data-hours-badge
  data-schedule={JSON.stringify(siteConfig.hours.schedule)}
>
  <span
    class:list={["badge-dot", initialStatus.isOpen ? "badge-dot--open" : "badge-dot--closed"]}
    data-hours-dot
  ></span>
  <span data-hours-text>{initialStatus.badgeText}</span>
</span>

<script>
  import { getHoursStatus } from "../utils/hours";

  function updateAllBadges() {
    const badges = document.querySelectorAll<HTMLElement>("[data-hours-badge]");
    badges.forEach((el) => {
      const scheduleRaw = el.dataset.schedule;
      if (!scheduleRaw) return;
      const schedule = JSON.parse(scheduleRaw);
      const status = getHoursStatus(schedule, new Date());
      const text = el.querySelector<HTMLElement>("[data-hours-text]");
      const dot = el.querySelector<HTMLElement>("[data-hours-dot]");
      if (text) text.textContent = status.badgeText;
      if (dot) {
        dot.classList.toggle("badge-dot--open", status.isOpen);
        dot.classList.toggle("badge-dot--closed", !status.isOpen);
      }
    });
  }

  updateAllBadges();
  setInterval(updateAllBadges, 60_000);
</script>

<style>
  .hours-badge--compact {
    font-size: var(--fs-xs);
    padding: var(--space-1) var(--space-3);
  }
</style>
