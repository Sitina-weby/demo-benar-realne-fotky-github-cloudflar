---
import { siteConfig } from "../data/site.config";
const { business, menu } = siteConfig;
---

<div class="sticky-cta">
  <a href={"tel:" + business.phone} class="btn btn-primary sticky-cta__btn">Zavolat</a>
  <a href={menu.url ?? menu.pagePath} class="btn btn-outline sticky-cta__btn">Jídelní lístek</a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--color-forest);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.2);
  }
  .sticky-cta__btn {
    flex: 1;
    color: #fff;
  }
  .sticky-cta .btn-primary {
    color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
