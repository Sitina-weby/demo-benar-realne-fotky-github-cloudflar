---
import { siteConfig } from "../data/site.config";

const { business } = siteConfig;
---

<div class="sticky-cta" aria-hidden="false">
  <a href={`tel:${business.phone}`} class="btn btn-outline sticky-cta__btn">
    📞 Zavolat
  </a>
  <a href="#rezervace" class="btn btn-primary sticky-cta__btn">
    Rezervovat stůl
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    background: #fff;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.12);
  }
  .sticky-cta__btn {
    flex: 1;
    text-align: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
