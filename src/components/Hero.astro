---
import { siteConfig } from "../data/site.config";
import Header from "./Header.astro";

const { hero, menu, business } = siteConfig;
const sizes = "(max-width: 768px) 960px, 1920px";
---

<section class="hero" id="hero">
  <Header />
  <picture class="hero__bg">
    <source type="image/webp" srcset={hero.image.webpSmall + " 960w, " + hero.image.webp + " 1920w"} sizes={sizes} />
    <img
      src={hero.image.jpg}
      srcset={hero.image.jpgSmall + " 960w, " + hero.image.jpg + " 1920w"}
      sizes={sizes}
      alt={hero.image.alt}
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div class="hero__overlay"></div>

  <div class="container hero__content">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>{hero.headline}</h1>
    <p class="hero__sub">{hero.subheadline}</p>
    <div class="hero__ctas">
      <a href={menu.url ?? menu.pagePath} class="btn btn-primary">Jídelní lístek</a>
      <a href={"tel:" + business.phone} class="btn btn-outline">Zavolat {business.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }
  .hero__bg,
  .hero__bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 28, 22, 0.88) 0%, rgba(20, 28, 22, 0.55) 60%, rgba(20, 28, 22, 0.35) 100%);
  }
  .hero__content {
    position: relative;
    padding-block: 7rem 4rem;
  }
  .hero .eyebrow {
    color: var(--color-brass-light);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    margin-bottom: var(--space-4);
  }
  .hero__sub {
    font-size: var(--fs-xl);
    max-width: 30ch;
    color: #f2e6d2;
    margin-bottom: var(--space-8);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
