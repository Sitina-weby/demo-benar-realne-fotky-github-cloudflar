---
import { siteConfig } from "../data/site.config";
import HoursBadge from "./HoursBadge.astro";

const { hero, business, about, verified, menuLink } = siteConfig;
const [main, second, third] = hero.images;
const menuHref = menuLink.externalUrl ?? menuLink.href;
const photos = [main, second, third];
---

<section class="hero" id="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">{business.type} &middot; Litvínov &middot; od roku {about.foundedYear}</p>
      <h1 class="hero__title">{hero.headline}</h1>
      <p class="hero__subtitle">{hero.subheadline}</p>

      {verified.openingHours && <div class="hero__badge-row"><HoursBadge /></div>}

      <ul class="hero__bullets">
        {hero.bullets.map((b) => <li>{b}</li>)}
      </ul>

      <div class="hero__ctas">
        <a href={menuHref} class="btn btn-primary">{menuLink.label}</a>
        <a href="#rezervace" class="btn btn-outline">Rezervovat stůl</a>
        <a href="#denni-menu" class="btn btn-outline">Denní menu</a>
      </div>
    </div>

    <div class="hero__collage" aria-label="Fotografie jídel z Benaru">
      {
        photos.map((img, i) => (
          <figure class:list={["hero__photo", `hero__photo--${i + 1}`]}>
            <picture>
              <source type="image/webp" srcset={img.webp} />
              <img src={img.jpg} alt={img.alt} loading={i === 0 ? "eager" : "lazy"} width="800" />
            </picture>
          </figure>
        ))
      }
      <p class="hero__caption">Skutečné fotografie z Benaru</p>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(circle at 85% 10%, rgba(192, 122, 58, 0.35), transparent 45%),
      var(--color-forest);
    color: #fff;
    padding-block: var(--space-12) var(--space-16);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }
  .hero__eyebrow {
    color: var(--color-brass-light);
  }
  .hero__title {
    color: #fff;
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    margin-bottom: var(--space-4);
  }
  .hero__subtitle {
    font-size: var(--fs-lg);
    max-width: 46ch;
    color: #f1e4d0;
  }
  .hero__badge-row {
    margin-bottom: var(--space-4);
  }
  .hero__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    display: grid;
    gap: var(--space-2);
    font-size: var(--fs-sm);
  }
  .hero__bullets li {
    padding-left: 1.4em;
    position: relative;
  }
  .hero__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-brass-light);
    font-weight: 700;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__collage {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-3);
    height: 420px;
  }
  .hero__photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lifted);
    border: 3px solid rgba(255, 255, 255, 0.12);
  }
  .hero__photo picture {
    display: block;
    height: 100%;
  }
  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__photo--1 {
    grid-row: 1 / 3;
  }
  .hero__caption {
    position: absolute;
    right: 0;
    bottom: -1.9rem;
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-brass-light);
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-20);
    }
    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
    }
    .hero__collage {
      height: 520px;
    }
  }
</style>
