---
import { siteConfig } from "../data/site.config";
import HoursBadge from "./HoursBadge.astro";

const { hero, business, about } = siteConfig;
const [mainImage] = hero.images;
---

<section class="hero" id="hero">
  <div class="hero__bg">
    {mainImage.webp && mainImage.jpg ? (
      <picture>
        <source srcset={mainImage.webp} type="image/webp" />
        <img src={mainImage.jpg} alt={mainImage.alt} class="hero__bg-img" loading="eager" />
      </picture>
    ) : (
      <img src={mainImage.src} alt={mainImage.alt} class="hero__bg-img" loading="eager" />
    )}
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">{business.fullName} &middot; Litvínov &middot; od roku {about.foundedYear}</p>
    <h1 class="hero__title">{hero.headline}</h1>
    <p class="hero__subtitle">{hero.subheadline}</p>

    <div class="hero__badge-row">
      <HoursBadge />
    </div>

    <ul class="hero__bullets">
      {hero.bullets.map((b) => <li>{b}</li>)}
    </ul>

    <div class="hero__ctas">
      {
        hero.ctaButtons.map((cta, i) => (
          <a href={cta.href} class:list={["btn", i === 0 ? "btn-primary" : "btn-outline"]}>
            {cta.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__bg picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(38, 51, 42, 0.55) 0%, rgba(38, 51, 42, 0.75) 60%, rgba(38, 51, 42, 0.92) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-16) var(--space-12);
  }

  .hero__eyebrow {
    color: var(--color-brass-light);
  }

  .hero__title {
    color: #fff;
    font-size: var(--fs-4xl);
    margin-bottom: var(--space-3);
  }

  .hero__subtitle {
    font-size: var(--fs-lg);
    max-width: 46ch;
    color: #f2e6d2;
  }

  .hero__badge-row {
    margin-bottom: var(--space-4);
  }

  .hero__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-sm);
  }
  .hero__bullets li {
    padding-left: 1.4em;
    position: relative;
  }
  .hero__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-brass-light);
    font-weight: 700;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 86vh;
    }
    .hero__bullets {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-6);
    }
  }
</style>
