---
// FullMenu — používá se jak na hlavní stránce (sekce), tak na podstránce
// /jidelni-listek (plná verze). Chování je identické, liší se jen okolní
// kontext stránky, proto je komponenta jedna a bezobsahová (data ze
// site.config.ts).
import { siteConfig } from "../data/site.config";

const { fullMenu, verified } = siteConfig;
const priceLabel = (p: number) => (verified.menuAndPrices ? `${p} Kč` : "cena: doplní klient");
---

<div class="full-menu">
  <p class="full-menu__note">{fullMenu.note}</p>
  <p class="full-menu__photo-note">Fotografie jídel jsou ilustrační, neodpovídají přesné podobě podávaného pokrmu.</p>
  <div class="full-menu__categories">
    {
      fullMenu.categories.map((category) => (
        <div class="full-menu__category card">
          <h3>{category.name}</h3>
          <ul>
            {category.items.map((item) => (
              <li>
                {item.image && (
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    loading="lazy"
                    class="full-menu__thumb"
                  />
                )}
                <span class="full-menu__item-name">
                  {item.name} <span class="full-menu__item-weight">({item.weight})</span>
                </span>
                <span class="full-menu__item-price">{priceLabel(item.price)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<style>
  .full-menu__note {
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-1);
  }
  .full-menu__photo-note {
    font-size: var(--fs-xs);
    font-style: italic;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-8);
  }
  .full-menu__categories {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  .full-menu__category h3 {
    margin-bottom: var(--space-4);
    color: var(--color-brass-dark);
  }
  .full-menu__category ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .full-menu__category li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--fs-sm);
    border-bottom: 1px dashed var(--color-bg-alt);
    padding-bottom: var(--space-2);
  }
  .full-menu__category li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .full-menu__thumb {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    object-fit: cover;
    flex-shrink: 0;
  }
  .full-menu__item-name {
    flex: 1;
  }
  .full-menu__item-weight {
    color: var(--color-ink-soft);
    font-size: var(--fs-xs);
  }
  .full-menu__item-price {
    font-weight: 700;
    color: var(--color-brass-dark);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .full-menu__categories {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
