---
import { siteConfig } from "../data/site.config";

const { ratingsSummary } = siteConfig;
---

<section class="section section--dark" id="hodnoceni">
  <div class="container">
    <p class="eyebrow">Hodnocení hostů</p>
    <h2>Co o nás říkají hosté</h2>
    <ul class="ratings">
      <li><strong>{ratingsSummary.facebookRecommend}</strong><span>doporučení na Facebooku ({ratingsSummary.facebookReviewCount} hodnocení)</span></li>
      <li><strong>{ratingsSummary.tripadvisor}/5</strong><span>Tripadvisor</span></li>
      <li><strong>{ratingsSummary.firmyCz}/5</strong><span>Firmy.cz</span></li>
    </ul>
    <p class="ratings__note">{ratingsSummary.sourceNote} Aktuálnost čísel ověří klient; citace hostů zatím neuvádíme — doplní klient.</p>
  </div>
</section>

<style>
  .ratings {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0;
    display: grid;
    gap: var(--space-4);
  }
  .ratings li {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
  }
  .ratings strong {
    font-family: var(--font-heading);
    font-size: var(--fs-4xl);
    color: var(--color-brass-light);
  }
  .ratings__note {
    font-size: var(--fs-xs);
    opacity: 0.8;
  }
  @media (min-width: 768px) {
    .ratings {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
